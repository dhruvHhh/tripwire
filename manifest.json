{
  "manifest_version": 3,
  "name": "Tripwire",
  "version": "0.4.0",
  "description": "Flags risky links on web pages with a small badge, using checks that run on your device.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_title": "Tripwire",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": [
        "src/lib/analyzer.js",
        "src/lib/bookkeeping.js",
        "src/lib/geometry.js",
        "src/lib/settings.js",
        "src/content/styles.js",
        "src/content/badge.js",
        "src/content/overlay.js",
        "src/content/scanner.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
